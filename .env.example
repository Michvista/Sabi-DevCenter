# Rumpty managed PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sabi?sslmode=require"
# Download the CA certificate from Rumpty's database Connection tab and store
# it in the API container. Set this to its absolute path (optional locally).
RUMPTY_POSTGRES_CA_CERT=
# For Rumpty deployments, inject the CA as a base64 environment secret instead
# of committing a certificate file. Base64 takes precedence over the path.
RUMPTY_POSTGRES_CA_BASE64=

# App services
PORT=8080
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8080
AUTH_JWT_SECRET=
# Required before creating a midwife account. Set a long random value and share only with trusted care-team testers.
MIDWIFE_INVITE_CODE=

# Rumpty platform API token for CLI/control-plane operations only; this does
# not replace the database connection, bucket keys, or inference project key.
RUMPTY_API_KEY=

# Rumpty inference (optional; do not send identifiable health information)
RUMPTY_INFERENCE_BASE_URL=https://chat.rumptycloud.com/v1
RUMPTY_INFERENCE_API_KEY=
RUMPTY_INFERENCE_MODEL=llama3.2:3b

# Rumpty managed Redis-compatible service (check availability in your workspace)
RUMPTY_REDIS_URL=
# Download/use the Redis provider CA certificate if its endpoint requires one.
RUMPTY_REDIS_CA_CERT=
RUMPTY_REDIS_CA_BASE64=

# Rumpty S3-compatible object storage (optional)
RUMPTY_S3_ENDPOINT=
RUMPTY_S3_REGION=
RUMPTY_S3_BUCKET=
RUMPTY_S3_ACCESS_KEY_ID=
RUMPTY_S3_SECRET_ACCESS_KEY=

# Optional integrations; all calls must be explicit user actions
YARNGPT_API_KEY=
YARNGPT_DEFAULT_VOICE=idera
# Groq handles explicit on-screen translations of static pregnancy guides.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# 9jaLingo supplies Nigerian Pidgin audio after the visible text is translated.
NINEJALINGO_API_KEY=
NINEJALINGO_PIDGIN_VOICE=ada_pcm
NINEJALINGO_MODEL=9jalingo-tts-1
# FatSecret OAuth 2.0 client credentials stay on the API server.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
# One-time book embedding index. No Gemini request runs while a guide is viewed.
GEMINI_API_KEY=
# Optional legacy Gemini File Search development store (not used by the site).
GEMINI_RAG_STORE=
GEMINI_RAG_INGESTED=
GEMINI_MODEL=gemini-3.8-flash

# Optional Azure Speech fallback (requires a Speech resource key and region).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_ENGLISH_VOICE=en-NG-EzinneNeural
# Azure Translator is a separate resource if machine translation is wanted.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Browser push: generate a VAPID pair with web-push; keep the private key server-side.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:contact@example.com
